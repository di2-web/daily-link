# SUPABASE CONFIGURATION:
# URL and anon/public key for Supabase Database, Auth, and Storage.
# Get these from your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (Flash-Lite analysis, Flash-Image generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional. For ultra-fast 0.3s Whisper speech-to-text (whisper-large-v3-turbo).
GROQ_API_KEY=""

# CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN: Optional. For Cloudflare Workers AI (FLUX.2 Klein 4B image generation).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

