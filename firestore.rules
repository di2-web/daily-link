rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isOwner(userId);
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Room Objects Collection
    match /room_objects/{objectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Shared Matches (合言葉おそろいアイテム生成)
    match /shared_matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Reaction Gifts Collection (花、コーヒー、メッセージカード)
    match /reaction_gifts/{giftId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Friends collection (Closed Friends)
    match /friends/{friendId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Mood Waves Collection (バイオリズム)
    match /mood_waves/{waveId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}

