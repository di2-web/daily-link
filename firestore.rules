rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isOwner(userId);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isOwner(userId);
    }

    // Room Objects Collection
    match /room_objects/{objectId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Friend Relations Collection
    match /friend_relations/{relationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Wave Canvas (バイオリズム・感情波)
    match /wave_canvas/{canvasId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Shared Matches (合言葉おそろいアイテム生成)
    match /shared_matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Reaction Gifts Collection
    match /reaction_gifts/{giftId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Friends collection (Legacy)
    match /friends/{friendId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
